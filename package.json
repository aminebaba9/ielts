{
  "name": "ielts-masterclass-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply ielts-members --local",
    "db:remote": "wrangler d1 migrations apply ielts-members --remote",
    "check": "node --check src/worker.js && node --check scripts/create-owner.mjs && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=22"
  }
}
