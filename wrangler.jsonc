{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ielts-masterclass",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ielts-members",
      "database_id": "7fd6b566-db8c-4321-b572-c796ec748d56",
      "migrations_dir": "migrations"
    }
  ]
}
